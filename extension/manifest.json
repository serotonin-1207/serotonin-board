{
  "manifest_version": 3,
  "name": "Serotonin 보드 도우미",
  "version": "0.2.0",
  "description": "부서 보드의 오늘 근무팀, 일정, 인수인계를 도구 막대와 사이드 패널에서 확인·체크하고, 알림을 받고, 파일을 보냅니다.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Serotonin 보드",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications", "contextMenus", "sidePanel"],
  "host_permissions": ["__SUPABASE_ORIGIN__/*"],
  "side_panel": {
    "default_path": "panel.html"
  }
}
